<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_usage_access"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Usage Access"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_notif_access"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notif Access"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_keyboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Keyboard"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_notif_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Apps for Notifications"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_media_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WhatsApp Voice Notes &amp; Videos"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search what you typed / opened / received"
        android:inputType="text"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/entry_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
